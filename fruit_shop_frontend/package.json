{
  "name": "react-kavia",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.30.1",
    "react-scripts": "^5.0.1"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test --watchAll=false",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,jsx,css,md,json,mjs}\"",
    "format:check": "prettier -c \"**/*.{js,jsx,css,md,json,mjs}\"",
    "depcheck": "depcheck",
    "cycles": "madge --circular --extensions js,jsx src",
    "audit:prod": "npm audit --omit=dev || true",
    "audit:all": "npm audit || true",
    "ci:verify": "npm-run-all -p lint format:check depcheck cycles",
    "eject": "react-scripts eject"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "cross-env": "^7.0.3"
  }
}
